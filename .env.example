# Supabase (required for real accounts, errands, chat and wallet data)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Maps - choose one provider and expose only its public browser key
VITE_MAPS_PROVIDER=mapbox
VITE_MAPBOX_PUBLIC_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN

# Payment provider is server-side only. NEVER put secret keys in VITE_ variables.
# Configure these in your Supabase Edge Function secrets.
PAYMENT_PROVIDER=flutterwave
FLW_SECRET_KEY=YOUR_SERVER_SIDE_SECRET
FLW_SECRET_HASH=YOUR_WEBHOOK_SECRET

# App settings
VITE_APP_NAME=ErrandGo
VITE_DEFAULT_CURRENCY=NGN
VITE_PLATFORM_FEE_PERCENT=10
